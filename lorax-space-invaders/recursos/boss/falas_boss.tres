&"morte_fase3_1": SubResource("Fala_morte_fase3_1"),
&"morte_fase3_2": SubResource("Fala_morte_fase3_2"),
&"morte_fase3_3": SubResource("Fala_morte_fase3_3"),
&"pause_luta": SubResource("Fala_pause_luta"),
