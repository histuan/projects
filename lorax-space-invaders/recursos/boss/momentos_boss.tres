script = ExtResource("1_passo")
tipo = 14
fator = 0.2

[sub_resource type="Resource" id="Passo_wave10_silencio_2"]
script = ExtResource("1_passo")
tipo = 24
pendente = "NA LUTA PELA MAIN (B1)"
rotulo = "MUSICA SOME"
nome = &"musica_some"

[sub_resource type="Resource" id="Momento_wave10_silencio"]
script = ExtResource("2_momento")
titulo = "SILENCIO"
passos = Array[ExtResource("1_passo")]([SubResource("Passo_wave10_silencio_1"), SubResource("Passo_wave10_silencio_2")])

